# Keep the build context small and reproducible.
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Never copy host backups, logs or local config into the image.
backups/
logs/
backup-config.toml

# Docs/editor noise not needed at build time.
.vscode/
.idea/
.DS_Store
Thumbs.db
